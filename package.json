{
  "name": "podcastcraft-ai",
  "version": "1.1.0",
  "description": "PodcastCraft AI",
  "author": "PodcastCraft AI Team",
  "homepage": "https://github.com/EdedArt/PodcastCraft_AI",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run_tests.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:mac:arm64": "electron-builder --mac --arm64",
    "build:mac:x64": "electron-builder --mac --x64",
    "build:linux": "electron-builder --linux",
    "build:linux:x64": "electron-builder --linux --x64",
    "build:all": "electron-builder -mwl"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.podcastcraft.ai",
    "productName": "PodcastCraft AI",
    "files": [
      "electron/**/*",
      "frontend/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          ".env",
          "!storage/audio-files/*",
          "!storage/tmp/*",
          "!storage/project.json",
          "!storage/auth.json"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "PodcastCraft AI.${ext}",
      "shortcutName": "PodcastCraft AI",
      "uninstallDisplayName": "PodcastCraft AI",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "identity": null,
      "artifactName": "PodcastCraft-AI-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "PodcastCraft-AI-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "artifactName": "PodcastCraft-AI-${version}-linux-x64.${ext}"
    },
    "deb": {
      "maintainer": "PodcastCraft AI Team <team@podcastcraft.ai>",
      "packageCategory": "sound",
      "priority": "optional"
    }
  }
}
